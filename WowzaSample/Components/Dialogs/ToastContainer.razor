@using WowzaSample.Components.Dialogs
@implements IDisposable
@inject ToastService ToastService

<style>
    .toast-container {
        position: fixed;
        top: 60px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 360px;
    }
    .toast-item {
        padding: 12px 16px;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        animation: toast-in 0.3s ease-out;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .toast-item.info { background: #3498db; }
    .toast-item.success { background: #27ae60; }
    .toast-item.warning { background: #f39c12; }
    .toast-item.error { background: #e74c3c; }
    @@keyframes toast-in {
        from { opacity: 0; transform: translateX(40px); }
        to { opacity: 1; transform: translateX(0); }
    }
</style>

<div class="toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="toast-item @toast.Type.ToString().ToLowerInvariant()">
            @toast.Text
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
        => ToastService.OnToastAdded += OnToast;

    private void OnToast(ToastMessage toast)
    {
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        // Auto-remove after 5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            _toasts.Remove(toast);
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
        => ToastService.OnToastAdded -= OnToast;
}
